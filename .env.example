# Local development (no Docker required)
# Production: DEBUG=false, set real CORS_ORIGINS to your domain, fill API keys
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI ---
# Real models: OPENAI_API_KEY=sk-... and leave OPENAI_BASE_URL empty
# Local mock: KEY=local + BASE_URL=http://127.0.0.1:8800/v1 + python backend/tools/local_provider.py
OPENAI_API_KEY=local
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=http://127.0.0.1:8800/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_PRIMARY=gemini
LLM_FALLBACK_ORDER=gemini,openai,anthropic

# Telegram (required for bot): @BotFather token + your numeric id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=0
TELEGRAM_ADMIN_TAG=@arxixx

# Reply delay (sec). Dev 8–20; prod often 30–120
REPLY_DELAY_MIN_SEC=8
REPLY_DELAY_MAX_SEC=20
PAYMENT_REMINDER_MINUTES=20
FOLLOWUP_DELAYS_HOURS=2,24,72

ESCROW_AUTO_CREATE=false
TRON_API_KEY=
TRON_MASTER_MNEMONIC=

USE_INPROCESS_SCHEDULER=true
USE_LOCAL_RAG=true

# Frontend production: set NEXT_PUBLIC_API_URL to public API origin (https://api.example.com)
# Logs file: data/logs/arix.log  |  API: GET /api/logs/tail
